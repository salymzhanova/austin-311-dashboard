# Template only: safe to commit because it contains no real value.
#
# Local use:  copy this file to .streamlit/secrets.toml (that file is git-ignored) and fill it in.
# Streamlit Community Cloud: paste the line below into  App settings -> Secrets.
#
# The token is OPTIONAL. Without it the app works, but Austin limits anonymous requests more strictly.

SOCRATA_APP_TOKEN = "paste-your-socrata-app-token-here"
